{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Go repos: also extend github>blackdark/renovate-base//go.json5 — see
  // that file. Default here stays language-agnostic; Go's go.mod directive,
  // mise go, and golang Docker images otherwise drift (Renovate skips the
  // go directive by default; matchPackageNames does not match mise's go).
  extends: [
    "config:best-practices",
    "customManagers:githubActionsVersions",
    "schedule:weekly",
    ":automergeMinor",
    ":automergeDigest",
    ":prConcurrentLimitNone",
    ":prHourlyLimitNone",
  ],
  timezone: "Europe/Berlin",
  // Fewer rebases, fewer CI runs: with the no-limit PR presets each merge to main would otherwise
  // rebase every open PR. Repos whose ruleset requires branches to be up to date must override this
  // with "behind-base-branch", or automerge stalls once a PR falls behind main (see README).
  rebaseWhen: "conflicted",
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
  },
  // Second advisory source next to GitHub's Dependabot alerts; works without the alerts enabled.
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    enabled: true,
    labels: ["dependencies", "security"],
    schedule: ["at any time"],
    // One day, not at once: pnpm 12 refuses packages younger than a day. Set here because
    // Renovate appends these rules after packageRules.
    minimumReleaseAge: "1 day",
    // Docker tags and other datasources without release dates must not wait forever
    minimumReleaseAgeBehaviour: "timestamp-optional",
    automerge: false,
  },
  labels: ["dependencies"],
  packageRules: [
    {
      groupName: "devDependencies (non-major)",
      groupSlug: "dev-dependencies-non-major",
      matchDepTypes: ["devDependencies"],
      matchUpdateTypes: ["patch", "minor"],
    },
    {
      groupName: "dependencies (non-major)",
      groupSlug: "dependencies-non-major",
      matchDepTypes: ["dependencies"],
      matchUpdateTypes: ["patch", "minor"],
    },
    {
      matchDepTypes: ["dependencies"],
      semanticCommitType: "refactor",
    },
    {
      matchDatasources: ["docker"],
      matchUpdateTypes: ["patch"],
      groupName: "all docker patch updates",
      groupSlug: "all-docker-patch",
    },
    {
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor"],
      groupName: "all docker minor updates",
      groupSlug: "all-docker-minor",
    },
    {
      matchUpdateTypes: ["digest"],
      groupName: "all digest updates",
      groupSlug: "all-digests",
    },
    {
      // After the digest catch-all so action digests stay in this group.
      // Restrict to action/workflow depTypes: github-actions also extracts
      // container/service/docker images from workflows — those stay in the
      // docker/digest groups above.
      matchManagers: ["github-actions"],
      matchDepTypes: ["action", "workflow"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      groupName: "GitHub Actions (non-major)",
      groupSlug: "github-actions-non-major",
    },
    {
      // Last, so it beats the automerge and groups above: 0.x minors may break (semver)
      description: "0.x: minor may break, own PR, review by hand",
      matchUpdateTypes: ["minor"],
      matchCurrentVersion: "/^v?0\\./",
      groupName: null,
      automerge: false,
    },
  ],
}
