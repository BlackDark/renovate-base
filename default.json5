{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
    "customManagers:githubActionsVersions",
    "schedule:weekly",
    ":automergeMinor",
    ":automergeDigest",
    ":prConcurrentLimitNone",
    ":prHourlyLimitNone",
  ],
  labels: ["dependencies"],
  packageRules: [
    {
      groupName: "devDependencies (non-major)",
      groupSlug: "dev-dependencies-non-major",
      matchDepTypes: ["devDependencies"],
      matchUpdateTypes: ["patch", "minor"],
    },
    {
      groupName: "dependencies (non-major)",
      groupSlug: "dependencies-non-major",
      matchDepTypes: ["dependencies"],
      matchUpdateTypes: ["patch", "minor"],
    },
    {
      matchDepTypes: ["dependencies"],
      semanticCommitType: "refactor",
    },
    {
      matchDatasources: ["docker"],
      matchUpdateTypes: ["patch"],
      groupName: "all docker patch updates",
      groupSlug: "all-docker-patch",
    },
    {
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor"],
      groupName: "all docker minor updates",
      groupSlug: "all-docker-minor",
    },
    {
      matchUpdateTypes: ["digest"],
      groupName: "all digest updates",
      groupSlug: "all-digests",
    },
    {
      // After the digest catch-all so action digests stay in this group.
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      groupName: "GitHub Actions (non-major)",
      groupSlug: "github-actions-non-major",
    },
  ],
}
