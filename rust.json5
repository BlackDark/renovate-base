{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Opt-in preset for Rust repos. Extend alongside default.json5:
  //   extends: [
  //     "github>blackdark/renovate-base//default.json5",
  //     "github>blackdark/renovate-base//rust.json5",
  //   ]
  //
  // Why this exists:
  // 1. Renovate has no manager for rust-toolchain.toml. The regex manager below
  //    bumps a pinned `channel = "x.y.z"`. Channels like "stable" or "esp" do not
  //    match and are left alone (an espup toolchain is bumped by hand together with
  //    the espup install version).
  // 2. default.json5 enables weekly lock file maintenance. For Cargo, that can
  //    select a new 0.x minor within the declared range, so those PRs need review.
  customManagers: [
    {
      customType: "regex",
      description: "Rust toolchain channel in rust-toolchain.toml",
      managerFilePatterns: ["/(^|/)rust-toolchain\\.toml$/"],
      matchStrings: ["channel\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "rust",
      packageNameTemplate: "rust-lang/rust",
      datasourceTemplate: "github-releases",
    },
  ],
  packageRules: [
    {
      description: "Cargo lock maintenance may include 0.x minors; review by hand",
      matchManagers: ["cargo"],
      matchUpdateTypes: ["lockFileMaintenance"],
      automerge: false,
    },
  ],
}
